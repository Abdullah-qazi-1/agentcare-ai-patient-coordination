# ---- LLM: any OpenAI-compatible provider (Groq, OpenAI, a self-hosted gateway, etc.) ----
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Optional per-agent model overrides (defaults to LLM_MODEL if unset).
# Useful for routing cheaper/faster models to high-volume classification agents.
LLM_MODEL__ROUTING=
LLM_MODEL__DOCUMENT=
LLM_MODEL__SAFETY=

# ---- Token limits ----
# Max OUTPUT tokens per model call. Agents return small structured objects, so a low
# ceiling is safe; a runaway generation is always a malfunction, not a long answer.
LLM_MAX_TOKENS=1024
# Per-agent overrides (0 or unset inherits LLM_MAX_TOKENS).
LLM_MAX_TOKENS__ROUTING=
LLM_MAX_TOKENS__DOCUMENT=
LLM_MAX_TOKENS__SAFETY=

# Total tokens (input + output) one patient request may consume across ALL agents.
# Exceeding this escalates to a human instead of continuing to spend.
WORKFLOW_TOKEN_BUDGET=120000
# Model calls a single agent may make before it is stopped.
AGENT_RUN_CALL_LIMIT=8
# Model calls one workflow may make in total.
WORKFLOW_THREAD_CALL_LIMIT=40
# Conversation tokens after which an agent summarizes rather than resending history.
SUMMARIZATION_TRIGGER_TOKENS=6000

# ---- Observability ----
# Native LangSmith tracing — independent of Logfire below. Get a key at
# https://smith.langchain.com/settings.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentcare-dev
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Logfire (Pydantic). Off by default — the app runs untraced with no credentials.
# Get a token with `uv run logfire auth` then `uv run logfire projects use agentcare`.
LOGFIRE_TOKEN=
LOGFIRE_PROJECT_NAME=agentcare
LOGFIRE_ENABLED=false
# Print spans to the console instead of the cloud — traces with no account needed.
LOGFIRE_CONSOLE=false
# Route LangChain/LangGraph spans to Logfire via LangSmith's OpenTelemetry bridge.
LOGFIRE_INSTRUMENT_LANGCHAIN=true

# ---- Guardrails ----
# NVIDIA NeMo Guardrails as an additional *semantic* input/output rail, on top of the
# deterministic safety scanner (app/services/safety_service.py) and the Safety agent.
# Off by default — a fresh clone / CI run with no LLM key must never be blocked by it.
NEMOGUARDRAILS_ENABLED=false

# ---- Database ----
# SQLite for local dev; swap for postgresql+psycopg2://user:pass@host:5432/dbname in prod
DATABASE_URL=sqlite:///./agentcare.db

# ---- Documents ----
# Max size (MB) for one uploaded report/document — enforced server-side and mirrored by
# a `data-max-bytes` attribute on the upload form so oversized files are rejected
# client-side before the round trip.
MAX_DOCUMENT_SIZE_MB=10

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# ---- App ----
ENV=development
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the JSON API cross-origin. The server-rendered
# UI is same-origin and unaffected by this; set it only if a separate client (mobile app,
# another site) needs to call the API directly from the browser.
CORS_ORIGINS=http://localhost:8000
